# Copy to .env and adjust. Loaded automatically by Executor (python-dotenv).

# Base URL of the urirun node Executor talks to (POST {url}/run, GET {url}/health, /routes).
URIRUN_NODE_URL=http://localhost:8765

# OpenAI-compatible LLM proxy for clients that want to reach OpenRouter via our domain.
URIRUN_LLM_API_BASE=https://llm.urirun.com/api/v1
# Direct OpenRouter fallback when bypassing the proxy.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Executor.capture_for_llm() screenshot limits — see docs/llm/runtime_semantics.md
# "Screenshots are multimodal, not text". A screenshot is attached as a separate
# multimodal image block, never embedded into build_first_system_prompt()'s text; these
# bound its size regardless of what the capture backend on the node actually returns
# (some backends ignore the requested max_width and return full resolution).
URIRUN_LLM_SCREENSHOT_MAX_WIDTH=1280
URIRUN_LLM_SCREENSHOT_MAX_BYTES=400000
